{
  "name": "Tasks · Sorting Frame",
  "colors": {
    "bg": {
      "light": "#FFFFFF",
      "dark": "#101010"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#262626"
    },
    "soft": {
      "light": "#F3F3F1",
      "dark": "#1A1A1A"
    },
    "line": {
      "light": "#E2E2DF",
      "dark": "#333333"
    },
    "ink": {
      "light": "#161616",
      "dark": "#EDEDED"
    },
    "muted": {
      "light": "#4A4A4A",
      "dark": "#B5B5B5"
    },
    "frame": {
      "light": "#161616",
      "dark": "#4A4A4A"
    },
    "accent": {
      "light": "#D62839",
      "dark": "#D62839"
    },
    "accent-ink": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF"
    },
    "accent-text": {
      "light": "#C8202F",
      "dark": "#FF6B76"
    },
    "sun": {
      "light": "#FFC53D",
      "dark": "#FFC53D"
    },
    "sun-ink": {
      "light": "#161616",
      "dark": "#161616"
    },
    "danger": {
      "light": "#A4161A",
      "dark": "#FF6B6B"
    },
    "mark": {
      "light": "#D62839",
      "dark": "#FF6B76"
    }
  },
  "typography": {
    "family": "Overpass Variable",
    "mono": "Overpass Mono Variable",
    "scale": {
      "display": "clamp(2.25rem,4.6vw,3.75rem)/1.05 800",
      "headline": "1.5rem/1.1 800",
      "title": "1rem/1.45 600",
      "body": "1rem/1.5 400",
      "label": "0.75rem 800 uppercase 0.09em",
      "meta": "0.75rem/1.5 mono 500"
    }
  },
  "rules": {
    "frame": "3px solid frame",
    "slotShade": "inset 0 14px 18px -14px rgb(0 0 0 / .25)",
    "slip": "0 1px 0 rgb(0 0 0 / .16)",
    "dropTarget": "inset 0 3px 0 accent"
  },
  "radius": {
    "base": "0px",
    "button": "2px"
  },
  "motion": {
    "easeOut": "cubic-bezier(.23,1,.32,1)",
    "easeDrawer": "cubic-bezier(.32,.72,0,1)",
    "slipDrop": "240ms easeOut (start page only)",
    "stamp": "180ms easeOut, 200ms delay (start page only)",
    "appAdd": "none",
    "drawerIn": "280ms easeDrawer",
    "palette": "instant"
  },
  "layout": {
    "slots": "repeat(auto-fill, minmax(280px, 1fr))",
    "firstView": "headline and input visible at 375x667 and 1280x720"
  }
}
