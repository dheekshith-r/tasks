# Optional Google sign-in (Firebase, free Spark plan). Copy to .env.production.local for local builds (tests never read it).
# In CI these come from GitHub Actions repository variables with the same names.
# Leave them empty and the app is guest-only: no sign-in button, no Firebase code loaded.
# These values identify the Firebase project; they are not secrets. Security comes from
# firestore.rules (owner-only access) and from restricting the API key to this site's domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
