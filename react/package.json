{
  "name": "tasks-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "csp": "node scripts/check-csp.mjs",
